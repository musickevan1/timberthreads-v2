# Enable only after storage, recipient and custom-domain sender are verified.
# Deploying this replacement without setup makes the contact form unavailable.
CONTACT_INTAKE_ENABLED=false

# Existing Upstash storage may be reused only after owner confirms access,
# capacity, privacy and eviction disabled. No serverless local-disk fallback.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Server-only Resend key; do not use onboarding@resend.dev in production.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contact@your-verified-domain.example
OWNER_EMAIL=timberandthreads24@gmail.com
